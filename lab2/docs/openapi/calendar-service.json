        "/health": {
            "get": {
                "tags": [
                    "service"
                ],
                "summary": "Стан екземпляра для Consul і Docker",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/calendars": {
            "post": {
                "tags": [
                    "calendars"
                ],
                "summary": "Create Calendar",
                "operationId": "create_calendar_calendars_post",
                "parameters": [
                    {
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Ідентифікатор користувача; до впровадження OIDC у ЛР5 його передає клієнт",
                            "title": "X-User-Id"
                        },
                        "description": "Ідентифікатор користувача; до впровадження OIDC у ЛР5 його передає клієнт"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CalendarIn"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CalendarOut"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/calendars/{calendar_id}": {
            "get": {
                "tags": [
                    "calendars"
                ],
                "summary": "Get Calendar",
                "operationId": "get_calendar_calendars__calendar_id__get",
                "parameters": [
                    {
                        "name": "calendar_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "title": "Calendar Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CalendarOut"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/events": {
            "post": {
                "tags": [
                    "events"
                ],
                "summary": "Створення події (далі — хореографія через RabbitMQ)",
                "operationId": "create_event_events_post",
                "parameters": [
                    {
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Ідентифікатор користувача; до впровадження OIDC у ЛР5 його передає клієнт",
                            "title": "X-User-Id"
                        },
                        "description": "Ідентифікатор користувача; до впровадження OIDC у ЛР5 його передає клієнт"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EventIn"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "title": "Response Create Event Events Post"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "tags": [
                    "events"
                ],
                "summary": "List Events",
                "operationId": "list_events_events_get",
                "parameters": [
                    {
                        "name": "calendarId",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "title": "Calendarid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object"
                                    },
                                    "title": "Response List Events Events Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/events/{event_id}": {
            "get": {
                "tags": [
                    "events"
                ],
                "summary": "Get Event",
                "operationId": "get_event_events__event_id__get",
                "parameters": [
                    {
                        "name": "event_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "title": "Event Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "title": "Response Get Event Events  Event Id  Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            },
            "patch": {
                "tags": [
                    "events"
                ],
                "summary": "Зміна події; перенесення виконує координатор (оркестрація)",
                "operationId": "patch_event_events__event_id__patch",
                "parameters": [
                    {
                        "name": "event_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "title": "Event Id"
                        }
                    },
                    {
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Ідентифікатор користувача; до впровадження OIDC у ЛР5 його передає клієнт",
                            "title": "X-User-Id"
                        },
                        "description": "Ідентифікатор користувача; до впровадження OIDC у ЛР5 його передає клієнт"
                    },
                    {
                        "name": "If-Match",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "If-Match"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EventPatch"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "title": "Response Patch Event Events  Event Id  Patch"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/events/{event_id}/cancel": {
            "post": {
                "tags": [
                    "events"
                ],
                "summary": "Скасування (далі — хореографія через RabbitMQ)",
                "operationId": "cancel_event_events__event_id__cancel_post",
                "parameters": [
                    {
                        "name": "event_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "title": "Event Id"
                        }
                    },
                    {
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Ідентифікатор користувача; до впровадження OIDC у ЛР5 його передає клієнт",
                            "title": "X-User-Id"
                        },
                        "description": "Ідентифікатор користувача; до впровадження OIDC у ЛР5 його передає клієнт"
                    },
                    {
                        "name": "If-Match",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "If-Match"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "title": "Response Cancel Event Events  Event Id  Cancel Post"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/events/{event_id}/overview": {
            "get": {
                "tags": [
                    "events"
                ],
                "summary": "Композиція даних трьох сервісів (синхронно)",
                "operationId": "event_overview_events__event_id__overview_get",
                "parameters": [
                    {
                        "name": "event_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "title": "Event Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "title": "Response Event Overview Events  Event Id  Overview Get"
                                }
                            }
