                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/diagnostics/chain": {
            "get": {
                "tags": [
                    "diagnostics"
                ],
                "summary": "Синхронний ланцюжок: кожен сервіс дописує свій фрагмент",
                "operationId": "diagnostics_chain_diagnostics_chain_get",
                "parameters": [
                    {
                        "name": "message",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "ping",
                            "title": "Message"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "title": "Response Diagnostics Chain Diagnostics Chain Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CalendarIn": {
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "timeZone": {
                        "type": "string",
                        "title": "Timezone",
                        "default": "Europe/Kyiv"
                    }
                },
                "type": "object",
                "required": [
                    "name"
                ],
                "title": "CalendarIn"
            },
            "CalendarOut": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Id"
                    },
                    "ownerId": {
                        "type": "string",
                        "title": "Ownerid"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "timeZone": {
                        "type": "string",
                        "title": "Timezone"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "ownerId",
                    "name",
                    "timeZone"
                ],
                "title": "CalendarOut"
            },
            "EventIn": {
                "properties": {
                    "calendarId": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Calendarid"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title"
                    },
                    "startAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Startat"
                    },
                    "endAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Endat"
                    },
                    "timeZone": {
                        "type": "string",
                        "title": "Timezone"
                    },
                    "inviteeUserIds": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Inviteeuserids"
                    },
                    "remindBeforeMinutes": {
                        "type": "integer",
                        "title": "Remindbeforeminutes",
                        "default": 15
                    }
                },
                "type": "object",
                "required": [
                    "calendarId",
                    "title",
                    "startAt",
                    "endAt",
                    "timeZone"
                ],
                "title": "EventIn"
            },
            "EventPatch": {
                "properties": {
                    "title": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Title"
                    },
                    "startAt": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date-time"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Startat"
                    },
                    "endAt": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date-time"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Endat"
                    },
                    "timeZone": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Timezone"
                    }
                },
                "type": "object",
                "title": "EventPatch"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
