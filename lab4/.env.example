# Скопіюйте у .env і вкажіть ключ. Підходить будь-який OpenAI-сумісний Chat Completions API.

# Google Gemini (ключ: https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# none — без міркувань (non-reasoning); low / medium / high — reasoning-режим
LLM_REASONING_EFFORT=none
# Безкоштовний тариф має ліміт запитів за хвилину: клієнт сам витримує паузи
LLM_MAX_RPM=12

# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4.1-mini   (LLM_REASONING_EFFORT порожній)
# Ollama на хості (поза Docker):  LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen3:8b

# Guardrails витрат (значення за замовчуванням)
# LLM_MAX_OUTPUT_TOKENS=2048
# LLM_SESSION_TOKEN_BUDGET=40000
# AGENT_MAX_STEPS=8
# AGENT_MAX_TOOL_CALLS=12
