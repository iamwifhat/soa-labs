                    "notifications"
                ],
                "summary": "Сповіщення користувача та стан доставки",
                "operationId": "list_notifications_notifications_get",
                "parameters": [
                    {
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Ідентифікатор користувача; до впровадження OIDC у ЛР5 його передає клієнт",
                            "title": "X-User-Id"
